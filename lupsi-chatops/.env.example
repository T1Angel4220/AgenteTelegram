# ===================================================================
# LUPSI ChatOps - Variables de Entorno de Ejemplo
# ===================================================================
# Copia este archivo como .env y completa los valores correspondientes:
# cp .env.example .env
# NUNCA subas tu archivo .env real con credenciales a repositorios públicos.
# ===================================================================

# Servidor / Aplicación
PORT=3000
NODE_ENV=development
WEBHOOK_URL=https://tu-dominio-o-render.com

# -------------------------------------------------------------------
# 1. Telegram Bot (Telegraf)
# -------------------------------------------------------------------
# Token obtenido a través de @BotFather en Telegram
TELEGRAM_TOKEN=123456789:ABCDefGhIJKlmNoPQRsTUVwxyZ
# Chat ID del administrador o grupo donde el bot envía alertas matutinas y de CI/CD
TELEGRAM_CHAT_ID=-1001234567890

# -------------------------------------------------------------------
# 2. Trello API (Gestión de Tareas y Tableros Kanban)
# -------------------------------------------------------------------
# Clave de API de desarrollador de Trello (https://trello.com/app-key)
TRELLO_KEY=tu_trello_api_key_aqui
# Token de acceso generado para el bot
TRELLO_TOKEN=tu_trello_server_token_aqui
# ID del tablero de Trello del proyecto
BOARD_ID=tu_trello_board_id_aqui

# -------------------------------------------------------------------
# 3. GitHub API (Monitoreo de Commits, PRs, Issues y CI/CD)
# -------------------------------------------------------------------
# Personal Access Token de GitHub con permisos de repo (repo, read:org, etc.)
GITHUB_TOKEN=ghp_tu_github_personal_access_token_aqui
# Propietario u organización del repositorio (ej. A1EXF6A o tu-usuario)
GITHUB_OWNER=tu_usuario_o_organizacion
# Nombre del repositorio
GITHUB_REPO=Lupsi
# Rama principal a monitorear (default: main)
GITHUB_BRANCH=main

# -------------------------------------------------------------------
# 4. Inteligencia Artificial (OpenRouter & NVIDIA NIM)
# -------------------------------------------------------------------
# API Key principal de OpenRouter (https://openrouter.ai/)
OPENROUTER_API_KEY=sk-or-v1-tu_openrouter_api_key_aqui

# Múltiples API Keys de OpenRouter separadas por coma (opcional, para failover/balanceo)
AI_KEYS=sk-or-v1-key1,sk-or-v1-key2

# Modelos preferidos en OpenRouter (separados por coma en orden de prioridad)
AI_MODELS=anthropic/claude-3.5-sonnet,meta-llama/llama-3.3-70b-instruct,deepseek/deepseek-chat

# API Key de NVIDIA NIM (opcional como fallback de alta velocidad)
NVIDIA_API_KEY=nvapi-tu_nvidia_api_key_aqui

# Modelos disponibles en NVIDIA NIM
NVIDIA_MODELS=meta/llama-3.1-70b-instruct,mistralai/mixtral-8x22b-instruct-v0.1

# -------------------------------------------------------------------
# 5. Base de Datos / Persistencia (Supabase)
# -------------------------------------------------------------------
# URL del proyecto en Supabase (ej. https://abcdefghijkl.supabase.co)
SUPABASE_URL=https://tu-proyecto.supabase.co
# Clave anónima o service role de Supabase
SUPABASE_KEY=tu_supabase_anon_o_service_key_aqui

